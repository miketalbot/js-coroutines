{
  "name": "js-coroutines",
  "sideEffects": [
    "./dist/polyfill.js"
  ],
  "version": "3.0.0",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENCE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miketalbot/js-coroutines.git"
  },
  "main": "dist/index.js",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "chai": "^6.3.0",
    "docdash": "^2.0.2",
    "express": "^5.3.0",
    "jsdoc": "^4.0.5",
    "lodash": "^4.18.1",
    "mocha": "^12.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "scripts": {
    "start": "vite --port 3012",
    "build:demo": "vite build",
    "dts": "mkdir -p dist/es6 && cp src/component/jscoroutines.d.ts dist/es6/jscoroutines.d.ts",
    "document": "jsdoc -c ./doc.conf.json",
    "document:copy": "npm run document && cp -r ./docs ../js-coroutines-web/public",
    "build": "sh ./scripts/build.sh",
    "push": "git push",
    "watch": "babel src/component --watch --ignore \"**/__tests__/**,**/*.spec.js,**/*.test.js,**/__snapshots__/**,**/test/**\" --out-dir dist",
    "test": "mocha --require @babel/register \"src/test/**/*.test.js\" --exit",
    "test-express": "npm run build && node ./src/test/basic-express.js"
  },
  "types": "dist/es6/jscoroutines.d.ts",
  "typings": "dist/es6/jscoroutines.d.ts",
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "error"
    }
  }
}
